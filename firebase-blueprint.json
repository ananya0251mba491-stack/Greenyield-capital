    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Public message thread reply on a support ticket.",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyOwnerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "maxLength": 120 },
        "senderRole": { "type": "string", "maxLength": 40 },
        "body": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketId", "companyId", "companyOwnerUid", "memberUids", "senderUid", "senderName", "senderRole", "body", "createdAt"]
    },
    "SupportInternalNote": {
      "title": "SupportInternalNote",
      "description": "Admin-only internal support note strictly invisible to SME company users.",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "maxLength": 120 },
        "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketId", "authorUid", "authorName", "note", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification record.",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "title", "message", "read", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable append-only audit trail of company and platform actions.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorEmail": { "type": "string", "maxLength": 254 },
        "actorRole": { "type": "string", "maxLength": 40 },
        "companyId": { "type": "string", "maxLength": 128 },
        "companyOwnerUid": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "minLength": 2, "maxLength": 120 },
        "entityType": { "type": "string", "maxLength": 80 },
        "entityId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorEmail", "actorRole", "companyId", "action", "entityType", "summary", "createdAt"]
    },
    "PlatformSetting": {
      "title": "PlatformSetting",
      "description": "Owner-managed platform settings, ESG templates, and financial scenario assumptions.",
      "type": "object",
      "properties": {
        "settingKey": { "type": "string", "maxLength": 80 },
        "visibility": { "type": "string", "enum": ["platform", "admin_only"] },
        "payload": { "type": "object" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["settingKey", "visibility", "payload", "updatedBy", "updatedAt"]
    },
    "PublicInquiry": {
      "title": "PublicInquiry",
      "description": "Public demo request or contact form submission.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "companyName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "phone": { "type": "string", "maxLength": 24 },
        "city": { "type": "string", "maxLength": 80 },
        "inquiryType": { "type": "string", "enum": ["Request Demo", "ESG Assessment", "Partnership", "General Enquiry"] },
        "message": { "type": "string", "minLength": 5, "maxLength": 1500 },
        "status": { "type": "string", "enum": ["new", "contacted", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "companyName", "email", "inquiryType", "message", "status", "createdAt"]
    }
  },
