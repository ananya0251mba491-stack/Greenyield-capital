        incoming().companyOwnerUid == existing().companyOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isPlatformOwner() ||
          (
            isCompanyMember(existing().companyId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'scope1Tonnes', 'scope2Tonnes', 'totalTonnes', 'electricityKwh',
              'renewableKwh', 'recordsCount', 'missingMonths', 'factorSnapshotNote', 'updatedAt'
            ])
          )
        );
