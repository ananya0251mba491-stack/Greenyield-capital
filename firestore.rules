          (
            isCompanyAdmin(existing().companyId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'facilityId', 'facilityName', 'reportingMonth', 'energyCategory',
              'fuelTypeLabel', 'quantity', 'unit', 'electricitySource',
              'renewableQuantity', 'scope', 'appliedFactorId', 'appliedFactorValue',
              'appliedFactorVersion', 'estimatedKgCo2e', 'estimatedTonnesCo2e',
              'attachmentDocId', 'attachmentName', 'notes', 'reviewStatus', 'updatedAt'
            ])
          ) ||
          (
            isCompanyMember(existing().companyId) &&
            incoming().reviewStatus == existing().reviewStatus &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'facilityId', 'facilityName', 'reportingMonth', 'energyCategory',
              'fuelTypeLabel', 'quantity', 'unit', 'electricitySource',
              'renewableQuantity', 'scope', 'appliedFactorId', 'appliedFactorValue',
              'appliedFactorVersion', 'estimatedKgCo2e', 'estimatedTonnesCo2e',
