    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isPlatformOwner() || isCompanyMember(existing().companyId));
      allow list: if isBootstrappedOwner() || isResourceMember(existing());
      allow create: if isVerifiedUser() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().status == 'Open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        companyExists(incoming().companyId) &&
        (isPlatformOwner() || isCompanyMember(incoming().companyId));
      allow update: if isVerifiedUser() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming()) &&
        incoming().companyId == existing().companyId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isPlatformOwner() ||
          (
            isCompanyMember(existing().companyId) &&
            existing().status != 'Closed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['priority', 'description', 'updatedAt'])
          )
        );
      allow delete: if isValidId(ticketId) && isPlatformOwner();
    }

    match /support_messages/{msgId} {
      allow get: if isValidId(msgId) && (isPlatformOwner() || isCompanyMember(existing().companyId));
      allow list: if isBootstrappedOwner() || isResourceMember(existing());
      allow create: if isVerifiedUser() &&
        isValidId(msgId) &&
        isValidSupportMessage(incoming()) &&
        incoming().senderUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/support_tickets/$(incoming().ticketId)) &&
        (isPlatformOwner() || isCompanyMember(incoming().companyId));
      allow update: if false;
      allow delete: if isValidId(msgId) && isPlatformOwner();
    }

    // STRICTLY ADMIN-ONLY: Company users can NEVER read or write internal support notes
    match /support_internal_notes/{noteId} {
      allow get: if isValidId(noteId) && isPlatformOwner();
      allow list: if isBootstrappedOwner();
      allow create: if isPlatformOwner() &&
        isValidId(noteId) &&
        isValidSupportInternalNote(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(noteId) && isPlatformOwner();
    }

    match /notifications/{notifId} {
      allow get: if isValidId(notifId) && (isPlatformOwner() || (isVerifiedUser() && existing().recipientUid == request.auth.uid));
      allow list: if isBootstrappedOwner() || (isVerifiedUser() && existing().recipientUid == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(notifId) &&
        isValidNotification(incoming()) &&
        incoming().createdAt == request.time &&
        (isPlatformOwner() || incoming().recipientUid == request.auth.uid);
      allow update: if isVerifiedUser() &&
        isValidId(notifId) &&
        isValidNotification(incoming()) &&
        incoming().recipientUid == existing().recipientUid &&
        incoming().createdAt == existing().createdAt &&
        (isPlatformOwner() || (existing().recipientUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read'])));
      allow delete: if isValidId(notifId) && (isPlatformOwner() || (isVerifiedUser() && existing().recipientUid == request.auth.uid));
    }

    // IMMUTABLE APPEND-ONLY AUDIT TRAIL
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && (isPlatformOwner() || (isVerifiedUser() && existing().companyOwnerUid == request.auth.uid));
      allow list: if isBootstrappedOwner() || (isVerifiedUser() && existing().companyOwnerUid == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /platform_settings/{settingId} {
      allow get: if isValidId(settingId) && (isPlatformOwner() || (isVerifiedUser() && existing().visibility == 'platform'));
      allow list: if isBootstrappedOwner() || (isVerifiedUser() && existing().visibility == 'platform');
      allow create: if isPlatformOwner() &&
        isValidId(settingId) &&
        isValidPlatformSetting(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isPlatformOwner() &&
        isValidId(settingId) &&
        isValidPlatformSetting(incoming()) &&
        incoming().settingKey == existing().settingKey &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isPlatformOwner();
    }

    // Public Website Contact & Demo Requests (Create-Only Publicly, Owner-Only Read)
    match /public_inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isPlatformOwner();
      allow list: if isBootstrappedOwner();
      allow create: if isValidId(inquiryId) &&
        isValidPublicInquiry(incoming()) &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time;
      allow update: if isPlatformOwner() &&
        isValidId(inquiryId) &&
        isValidPublicInquiry(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(inquiryId) && isPlatformOwner();
    }
  }
}
