    match /esg_reports/{reportId} {
      allow get: if isValidId(reportId) && (isPlatformOwner() || isCompanyMember(existing().companyId) || isReviewer());
      allow list: if isBootstrappedOwner() || isResourceMember(existing());
      allow create: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidEsgReport(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().status in ['draft', 'submitted'] &&
        companyExists(incoming().companyId) &&
        (isPlatformOwner() || isCompanyMember(incoming().companyId));
      allow update: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidEsgReport(incoming()) &&
        incoming().companyId == existing().companyId &&
        incoming().companyOwnerUid == existing().companyOwnerUid &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isPlatformOwner() ||
          (
            existing().status != 'archived' && (
              // Tier 1: Company Admin / CFO can edit content and approve internally or archive
              (
                isCompanyAdmin(existing().companyId) &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'title', 'reportingPeriod', 'organizationalBoundary', 'totalElectricityKwh',
                  'renewableElectricityKwh', 'scope1Tonnes', 'scope2Tonnes', 'totalTonnes',
                  'previousPeriodTonnes', 'dataCompletenessPct', 'sustainabilityInitiatives',
                  'energyReductionSummary', 'dataSources', 'methodology', 'limitations',
                  'managementNotes', 'supportingDocCount', 'status', 'verificationLabel',
                  'approvedBy', 'updatedAt'
                ])
              ) ||
              // Tier 2: Regular company user can edit draft/submitted content, never approve internally
              (
                isCompanyMember(existing().companyId) &&
                incoming().status in ['draft', 'submitted'] &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'title', 'reportingPeriod', 'organizationalBoundary', 'totalElectricityKwh',
                  'renewableElectricityKwh', 'scope1Tonnes', 'scope2Tonnes', 'totalTonnes',
                  'previousPeriodTonnes', 'dataCompletenessPct', 'sustainabilityInitiatives',
                  'energyReductionSummary', 'dataSources', 'methodology', 'limitations',
                  'managementNotes', 'supportingDocCount', 'status', 'updatedAt'
                ])
              ) ||
              // Tier 3: Assigned Verification Reviewer can update review status and feedback only
              (
                isReviewer() &&
                incoming().status in ['under_review', 'changes_requested'] &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'verificationLabel', 'reviewerFeedback', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if isValidId(reportId) && (isPlatformOwner() || isCompanyAdmin(existing().companyId));
    }

    match /report_reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (
        isPlatformOwner() ||
        isCompanyMember(existing().companyId) ||
        (isReviewer() && existing().reviewerUid == request.auth.uid)
      );
      allow list: if isBootstrappedOwner() ||
        isResourceMember(existing()) ||
        (isVerifiedUser() && existing().reviewerUid == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidReportReview(incoming()) &&
        incoming().submittedBy == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        companyExists(incoming().companyId) &&
