        );
      allow delete: if isValidId(recordId) && (isPlatformOwner() || isCompanyAdmin(existing().companyId));
    }

    match /emission_factors/{factorId} {
      allow get: if isValidId(factorId) && (isPlatformOwner() || (isVerifiedUser() && existing().visibility == 'platform'));
      allow list: if isBootstrappedOwner() || (isVerifiedUser() && existing().visibility == 'platform');
      allow create: if isPlatformOwner() &&
        isValidId(factorId) &&
        isValidEmissionFactor(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
