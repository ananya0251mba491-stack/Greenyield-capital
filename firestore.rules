    match /emissions_calculations/{calcId} {
      allow get: if isValidId(calcId) && (isPlatformOwner() || isCompanyMember(existing().companyId) || isReviewer());
      allow list: if isBootstrappedOwner() || isResourceMember(existing());
      allow create: if isVerifiedUser() &&
        isValidId(calcId) &&
        isValidEmissionsCalculation(incoming()) &&
        incoming().calculatedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        companyExists(incoming().companyId) &&
        (isPlatformOwner() || isCompanyMember(incoming().companyId));
      allow update: if isVerifiedUser() &&
